{
  "name": "@open-mercato/cezar",
  "version": "0.9.2",
  "description": "Local cockpit for running and tracking AI agent tasks in your repo. Uses your logged-in `claude` CLI and `gh` — zero config, zero database.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cezar": "dist/index.js",
    "cez": "dist/index.js",
    "cezar-cli": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app-type": "./dist/server/app-type.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web/dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:rust-server": "node scripts/test-rust-server.mjs",
    "test:watch": "vitest",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.1",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@open-mercato/cezar-api-client": "^0.9.2",
    "@open-mercato/cezar-contract": "^0.9.2",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blakepiper/coducktor",
    "directory": "packages/cezar"
  },
  "publishConfig": {
    "access": "public"
  }
}
