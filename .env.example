# Coducktor environment variables — copy to `.env` and adjust. Every var is optional;
# the defaults give a zero-config local cockpit. Coducktor never auto-loads `.env`.

# ---- agent CLIs -------------------------------------------------------------
# Override the discovered path to each backend CLI (defaults: found on PATH).
# DUCK_CLAUDE_BIN=/usr/local/bin/claude
# DUCK_CODEX_BIN=/usr/local/bin/codex
# DUCK_OPENCODE_BIN=/usr/local/bin/opencode
# DUCK_PI_BIN=/usr/local/bin/pi
# Optional GitHub CLI path override used by the GitHub tab and PR actions.
# DUCK_GH_BIN=/usr/local/bin/gh

# The agents' OWN home variables are honored where the vendor documents one:
# setting one here moves that agent's DEFAULT account. A SECOND login of
# the same CLI is deliberately NOT configured through the environment, because a process-wide
# variable cannot differ per project: add it in Settings → Agent accounts and pick it per project,
# and the two accounts can then be used side by side.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex

# Enable supported provider approval gates instead of fully autonomous execution. Claude uses its
# edit-approval mode; Codex parks command/file requests in Needs You for an in-thread decision.
# DUCK_APPROVAL_GATE=1

# The child-agent environment is curated by default. Add explicitly named host variables when a
# provider integration needs them, or opt into the complete host environment (which may include
# secrets). These are security controls; prefer the narrow allowlist.
# DUCK_ENV_PASSTHROUGH=VAR_ONE,VAR_TWO
# DUCK_AGENT_ENV_FULL=1

# Codex runs with full tool access by default. Set to 0 to opt into its network-blocked
# workspace-write sandbox.
# DUCK_CODEX_NETWORK=0
# DUCK_CODEX_REASONING=high

# ---- project folders --------------------------------------------------------
# Zero-config default for the Add project folders. Saved values in Global
# Settings → Projects override this default. Missing checkout folders are
# created recursively when saved and when a clone starts.
# DUCK_PROJECTS_DIR=~/coducktor/projects

# ---- local state and startup UI ---------------------------------------------
# Override the global state directory (default: `~/.coducktor`). An empty value falls back to
# the default. Missing, corrupt or read-only state falls back to defaults and keeps running.
# DUCK_HOME=/path/to/coducktor-state
# Per-project Scratchpads are stored beneath this directory in `scratchpads/`; they never live
# in the repository and are not committed to Git.

# ---- review gate -------------------------------------------------------------
# Optional diff-first review gate (#489). OFF by default: a successful run with
# changes settles straight to `done`, leaving the diff in the worktree. Set
# DUCK_REVIEW_GATE=1 to make a changed non-autonomous run park at `review` for a
# human to Accept / Send back / open a Draft PR. Only the exact string "1"
# enables it ("true"/"yes" are treated as off). The Settings → Agents toggle,
# when set, wins over this env default. Autonomous runs ALWAYS skip the gate.
# DUCK_REVIEW_GATE=1

# ---- automatic recovery commits ----------------------------------------------
# In isolated task worktrees, Coducktor commits completed turns and terminal run state as
# `coducktor autosave (turn end|run finalize)`. A pre-PR flush uses `(pre-PR)`. In-place runs
# never receive automatic commits, so the repository root's user edits remain untouched.

# ---- GitHub -----------------------------------------------------------------
# Used for the GitHub tab / PR actions. The `gh` CLI's own auth is preferred; set
# this only if you drive git/gh through a token instead.
# GITHUB_TOKEN=ghp_xxx

# ---- testing / internal -----------------------------------------------------
# Show sanitized frame diagnostics in the status bar: total frame time, thread projection time,
# events reduced, and dropped live events. Exact 1 enables it. Useful for diagnosing a sluggish
# cockpit without rebuilding; it never includes prompts, provider payloads, or credentials.
# DUCK_DEBUG_HUD=1

# Run agents against a mock CLI (no real model calls) — used by the test suite.
# DUCK_DRY_RUN=1

# Lock model selection to the defaults in native Claude/Codex/OpenCode settings.
# `"modelsLocked": true` in global `~/.coducktor/config.json` or a project's local
# `~/.coducktor/projects/<project-key>/config.json` enables the same policy.
# Exact `1` also delegates provider authentication/enablement to the native
# agents: Coducktor skips its credential probes and provider-disable preferences,
# while Claude/Codex/OpenCode runner selection remains available.
# DUCK_AGENT_MODELS_LOCKED=1
# DUCK_MOCK_ARGS_FILE=/tmp/duck-mock-args.json
# Coducktor sets this for child agent processes; you should not set it:
#   DUCK_HANDOFF_FILE
