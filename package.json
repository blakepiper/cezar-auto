{
  "name": "cezar-monorepo",
  "private": true,
  "description": "Workspace root for cezar. Publishes nothing itself — see packages/*.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contract",
    "packages/cezar"
  ],
  "scripts": {
    "build": "npm run build:server",
    "build:server": "npm run build -w @open-mercato/cezar",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @open-mercato/cezar --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "npm run test:unit -w @open-mercato/cezar",
    "test:e2e": "sh .ai/scripts/e2e.sh",
    "pretypecheck": "npm run build:server",
    "typecheck": "npm run typecheck:contract && npm run typecheck:server",
    "typecheck:server": "npm run typecheck -w @open-mercato/cezar",
    "typecheck:contract": "npm run typecheck -w @open-mercato/cezar-contract"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blakepiper/coducktor"
  }
}
